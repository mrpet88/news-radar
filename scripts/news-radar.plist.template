<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  News Radar local collector — TEMPLATE.

  Do not install this file directly. `scripts/install-agent.sh` substitutes
  __PROJECT_DIR__ and installs the result, which keeps absolute paths (and so the
  local account name) out of the repository.

  The project must live outside ~/Documents, ~/Desktop and ~/Downloads: macOS TCC
  blocks a LaunchAgent from reading those, and the job fails with "can't open input
  file" even though the same script runs fine by hand.

  Reload after editing:
    launchctl bootout gui/$(id -u)/local.news-radar
    ./scripts/install-agent.sh

  Run once now (ignores the schedule, still honours the script's own guards):
    launchctl kickstart -k gui/$(id -u)/local.news-radar

  Four fire times, not one: the script works at most once per 20h, so these are
  chances to catch the Mac awake rather than four separate collections. A missed
  slot is also re-run by launchd at next wake.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.news-radar</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/run-local.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- The scheduled run is the only path that commits and pushes. -->
    <key>NEWS_RADAR_PUSH</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>45</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>45</integer></dict>
  </array>

  <!-- Never on load: installing the agent should not immediately drive Chrome. -->
  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/launchd.log</string>

  <!-- Collection is background work; keep it off the interactive CPU. -->
  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
