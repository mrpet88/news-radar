<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  News Radar morning trigger — TEMPLATE. Installed by `scripts/install-agent.sh`
  alongside the collector; see news-radar.plist.template for why it is a template.

  Ticks every 5 minutes. scripts/morning-trigger.sh exits at once unless today's
  delivery run has not been started yet AND you have used the keyboard or mouse in
  the last few minutes, so almost every tick costs one `ioreg` call.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.news-radar.morning</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>__PROJECT_DIR__/scripts/morning-trigger.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>NEWS_RADAR_PUSH</key>
    <string>1</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartInterval</key>
  <integer>300</integer>

  <key>RunAtLoad</key>
  <false/>

  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>

  <key>StandardOutPath</key>
  <string>__PROJECT_DIR__/data/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>__PROJECT_DIR__/data/launchd.log</string>

  <key>ProcessType</key>
  <string>Background</string>
  <key>LowPriorityIO</key>
  <true/>
</dict>
</plist>
